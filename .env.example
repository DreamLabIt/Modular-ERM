# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/modular_erm?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Platform Super Admin (optional; created/updated by seed) ───────────────
# Minimum 12 characters. Never commit real credentials.
# PLATFORM_ADMIN_EMAIL="platform@example.com"
# PLATFORM_ADMIN_PASSWORD="replace-with-a-long-random-password"
# PLATFORM_ADMIN_NAME="Platform Super Admin"
# If both are unset in development, seed creates a local-only demo:
#   platform@demo.local / Platform@123 (never created in production).

# ── Login security / rate limiting ──────────────────────────────────────────
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_EMAIL=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# ── Scheduled workers ───────────────────────────────────────────────────────
# Required for /api/cron/notifications and /api/cron/billing.
CRON_SECRET="replace-with-a-different-long-random-secret"

# ── Notifications ───────────────────────────────────────────────────────────
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Modular ERM <notifications@example.com>"
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM_NUMBER="+8801700000000"

# ── Billing / payment policy ───────────────────────────────────────────────
# Billing defaults are stored in the PlatformSetting table and editable in
# /platform-admin/settings. These two environment values are optional.
BILLING_GRACE_DAYS=7
# BILLING_AUTO_CHARGE_PROVIDER=""   # only SSLCOMMERZ supports unattended charge attempts
BILLING_SUPPORT_EMAIL="billing@example.com"

# ── SSLCommerz (Bangladesh gateway) ────────────────────────────────────────
# Leave unset to keep the gateway disabled. No credentials are stored in DB.
# SSLCOMMERZ_STORE_ID="your-store-id"
# SSLCOMMERZ_STORE_PASSWORD="your-store-password"
# SSLCOMMERZ_WEBHOOK_SECRET="your-hmac-secret"
# SSLCOMMERZ_ENVIRONMENT="SANDBOX"   # or LIVE

# ── bKash / Nagad (adapter only — checkout not enabled) ────────────────────
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_ACCOUNT_NUMBER=""
# NAGAD_MERCHANT_ID=""
# NAGAD_ACCOUNT_NUMBER=""

# ── Database backup / restore (platform operators only) ────────────────────
# BACKUP_OPERATOR_EMAILS="admin@example.com,ops@example.com"
# BACKUP_SCHEDULE="0 2 * * *"
# BACKUP_RETENTION_DAYS=30

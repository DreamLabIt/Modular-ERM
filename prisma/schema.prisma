generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

// 1. CORE: MULTI-TENANT, WHITE-LABEL, USER & ROLE
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#2563eb")
  currency     String   @default("BDT")
  address      String?
  plan         String   @default("ENTERPRISE")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                 User[]
  roles                 Role[]
  modules               OrganizationModule[]
  products              Product[]
  warehouses            Warehouse[]
  customers             Customer[]
  leads                 Lead[]
  invoices              Invoice[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  employees             Employee[]
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]
  payrolls              Payroll[]
  projects              Project[]
  tasks                 ProjectTask[]
  transactions          AccountTransaction[]
  invoicePayments       InvoicePayment[]
  invoiceStockMovements InvoiceStockMovement[]
  securityAuditLogs     SecurityAuditLog[]
  stockMovements        StockMovement[]
  purchaseOrderApprovals PurchaseOrderApproval[]
  goodsReceipts         GoodsReceipt[]
}

model OrganizationModule {
  id             String   @id @default(cuid())
  organizationId String
  moduleKey      String
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleKey])
}

model Role {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  permissions          String[]
  isSystem             Boolean  @default(false)
  isActive             Boolean  @default(true)
  authorizationVersion Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  roleId         String
  name           String
  email          String   @unique
  passwordHash   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                    Role               @relation(fields: [roleId, organizationId], references: [id, organizationId])
  securityAuditLogs       SecurityAuditLog[] @relation("SecurityAuditActor")
  receivedInvoicePayments InvoicePayment[]   @relation("InvoicePaymentReceiver")
  goodsReceipts           GoodsReceipt[]
  createdPurchaseOrders   PurchaseOrder[]   @relation("PO_Created")
  approvedPurchaseOrders  PurchaseOrder[]   @relation("PO_Approved")
}

model SecurityAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String
  targetType     String
  targetId       String
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation("SecurityAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
}

// 2. HR MANAGEMENT (EMPLOYEE, ATTENDANCE, LEAVE)
model Employee {
  id             String   @id @default(cuid())
  organizationId String
  employeeCode   String
  fullName       String
  designation    String
  department     String
  joiningDate    DateTime
  basicSalary    Decimal  @db.Decimal(12, 2)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  payrolls      Payroll[]
  projectTasks  ProjectTask[]

  @@unique([organizationId, employeeCode])
}

model Attendance {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  date           DateTime  @db.Date
  checkIn        DateTime?
  status         String    @default("PRESENT")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model LeaveRequest {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  leaveType      String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  days           Int      @default(1)
  reason         String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// 3. PAYROLL (SALARY, BONUS, DEDUCTIONS)
model Payroll {
  id             String    @id @default(cuid())
  organizationId String
  employeeId     String
  month          Int
  year           Int
  basicSalary    Decimal   @db.Decimal(12, 2)
  bonus          Decimal   @default(0) @db.Decimal(12, 2)
  deductions     Decimal   @default(0) @db.Decimal(12, 2)
  netSalary      Decimal   @db.Decimal(12, 2)
  status         String    @default("APPROVED")
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

// 4. CRM (CUSTOMER & CLIENT MANAGEMENT)
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  address        String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  projects     Project[]
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  contactName    String
  email          String?
  phone          String?
  estimatedValue Decimal  @default(0) @db.Decimal(12, 2)
  stage          String   @default("NEW")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// 5. PROJECT MANAGEMENT (PROJECTS, TASKS, DEADLINES)
model Project {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  name           String
  description    String?
  deadline       DateTime?
  budget         Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("IN_PROGRESS")
  createdAt      DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id])
  tasks        ProjectTask[]
}

model ProjectTask {
  id                 String            @id @default(cuid())
  organizationId     String
  projectId          String
  title              String
  assigneeName       String?
  assigneeEmployeeId String?
  dueDate            DateTime?
  priority           String            @default("MEDIUM")
  status             ProjectTaskStatus @default(TODO)
  createdAt          DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     Employee?    @relation(fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)

  @@index([assigneeEmployeeId])
}

// 6. ACCOUNTING (INCOME, EXPENSE, PROFIT/LOSS)
model AccountTransaction {
  id               String   @id @default(cuid())
  organizationId   String
  type             String
  category         String
  reference        String?
  description      String
  amount           Decimal  @db.Decimal(12, 2)
  date             DateTime @default(now())
  invoicePaymentId String?  @unique

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoicePayment InvoicePayment? @relation(fields: [invoicePaymentId], references: [id], onDelete: Restrict)
}

// 7. INVENTORY (STOCK, PURCHASE, PRODUCTS)
model Warehouse {
  id                    String                 @id @default(cuid())
  organizationId        String
  name                  String
  location              String?
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks                StockItem[]
  invoiceStockMovements InvoiceStockMovement[]
  goodsReceipts         GoodsReceipt[]
  purchases             PurchaseOrder[]
  stockMovements        StockMovement[]
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  unit           String   @default("pcs")
  costPrice      Decimal  @db.Decimal(12, 2)
  sellingPrice   Decimal  @db.Decimal(12, 2)
  reorderLevel   Int      @default(5)
  createdAt      DateTime @default(now())

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks                StockItem[]
  invoiceItems          InvoiceItem[]
  invoiceStockMovements InvoiceStockMovement[]
  purchaseOrderItems    PurchaseOrderItem[]
  goodsReceiptItems     GoodsReceiptItem[]
  stockMovements        StockMovement[]

  @@unique([organizationId, sku])
}

model StockItem {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

// 8. SALES & PURCHASE (SALES INVOICES, PURCHASE ORDERS)
model Invoice {
  id                String    @id @default(cuid())
  organizationId    String
  customerId        String
  invoiceNumber     String
  status            String    @default("DRAFT") // DRAFT, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  subtotal          Decimal   @db.Decimal(12, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal   @db.Decimal(12, 2)
  issueDate         DateTime?
  dueDate           DateTime?
  paidAt            DateTime?
  inventoryDeducted Boolean   @default(false)
  stockRestored     Boolean   @default(false)
  cancelledAt       DateTime?
  cancelledById     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer               @relation(fields: [customerId], references: [id])
  items          InvoiceItem[]
  payments       InvoicePayment[]
  stockMovements InvoiceStockMovement[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model InvoicePayment {
  id              String   @id @default(cuid())
  organizationId  String
  invoiceId       String
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime
  paymentMethod   String
  referenceNumber String?
  notes           String?
  receivedById    String?
  idempotencyKey  String?
  createdAt       DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy         User?               @relation("InvoicePaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  accountTransaction AccountTransaction?

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paymentDate])
}

model InvoiceStockMovement {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  productId      String
  warehouseId    String
  quantity       Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, productId, warehouseId])
  @@index([organizationId, invoiceId])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
}

// 8b. PURCHASE ORDER & GOODS RECEIPT WORKFLOW
// PurchaseOrder status lifecycle:
//   DRAFT -> PENDING_APPROVAL -> APPROVED -> SENT -> PARTIALLY_RECEIVED -> RECEIVED
// Additional terminal states: REJECTED, CANCELLED
// Stock increases ONLY after a valid GoodsReceipt (GRN) is recorded.
model PurchaseOrder {
  id                 String   @id @default(cuid())
  organizationId     String
  supplierId         String
  poNumber           String
  status             String   @default("DRAFT")
  totalAmount        Decimal  @db.Decimal(12, 2)
  warehouseId        String
  expectedDate       DateTime?
  receivedDate       DateTime?
  createdById        String?
  approvedById       String?
  approvedAt         DateTime?
  rejectionReason    String?
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Records that existed before this workflow was introduced with status
  // RECEIVED but were never linked to a GoodsReceipt. They are terminal and
  // are not modified.
  legacyReceivedAt   DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  createdBy      User?                 @relation(fields: [createdById], references: [id], name: "PO_Created")
  approvedBy     User?                 @relation(fields: [approvedById], references: [id], name: "PO_Approved")
  items          PurchaseOrderItem[]
  approvals      PurchaseOrderApproval[]
  goodsReceipts  GoodsReceipt[]
  stockMovements StockMovement[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, status])
}

model PurchaseOrderItem {
  id                 String   @id @default(cuid())
  purchaseOrderId    String
  productId          String
  orderedQuantity    Int
  previouslyReceived Int      @default(0)
  unitCost           Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  notes              String?

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]
}

model PurchaseOrderApproval {
  id             String   @id @default(cuid())
  organizationId String
  purchaseOrderId String
  action         String // 'SUBMITTED_FOR_APPROVAL' | 'APPROVED' | 'REJECTED'
  approvedById   String?
  rejectedReason String?
  createdAt      DateTime @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId, createdAt])
}

// A GoodsReceipt (GRN) represents the physical goods received from a supplier.
// Only ACCEPTED quantities from a valid GRN are added to inventory.
model GoodsReceipt {
  id              String   @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  receiptNumber   String
  warehouseId     String
  receivedDate    DateTime @default(now())
  status          String   @default("RECORDED") // RECORDED | VOID
  notes           String?
  receivedById    String
  idempotencyKey  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy      User                @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]
  stockMovements  StockMovement[]

  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receivedDate])
}

model GoodsReceiptItem {
  id                  String   @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  orderedQuantity     Int
  previouslyReceived  Int
  receivedQuantity    Int
  acceptedQuantity    Int
  rejectedQuantity    Int
  unitCost            Decimal  @db.Decimal(12, 2)
  notes               String?

  goodsReceipt       GoodsReceipt     @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem  PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product            Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([productId])
}

// Stock ledger. quantity is signed: positive deltas increase StockItem.quantity
// and negative deltas decrease it. Only PURCHASE_RECEIPT rows are created from GRNs.
model StockMovement {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  warehouseId    String
  movementType   String   // 'PURCHASE_RECEIPT' | 'SALE' | 'TRANSFER_IN' | 'TRANSFER_OUT' | 'ADJUSTMENT_IN' | 'ADJUSTMENT_OUT'
  quantity       Int
  referenceType  String
  referenceId    String
  goodsReceiptId String?
  purchaseOrderId String?
  unitCost       Decimal? @db.Decimal(12, 2)
  movementDate   DateTime @default(now())
  createdById    String?
  createdAt      DateTime @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  goodsReceipt    GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, warehouseId])
  @@index([organizationId, referenceType, referenceId])
  @@unique([goodsReceiptId, productId, warehouseId])
}
